	column 'Category Eng'
		dataType: string
		lineageTag: 3b5b859b-1ba6-4910-88f6-104f05f25e06
		summarizeBy: none
		sourceColumn: Category Eng

		annotation SummarizationSetBy = Automatic

	column 'Price Tier' =
			SWITCH(
			    TRUE(),
			    tourism_with_id[Price] = 0, "Free",
			    tourism_with_id[Price] <= 20000, "Budget (≤20K)",
			    tourism_with_id[Price] <= 50000, "Mid-range (20K–50K)",
			    tourism_with_id[Price] <= 150000, "Premium (50K–150K)",
			    "Luxury (150K+)"
			)
		lineageTag: 92a6ea6b-6f1a-4ab3-84bd-e753415e64b9
		summarizeBy: none
		sortByColumn: 'Price Tier Sort'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Price Tier Sort' =
			SWITCH(
			    TRUE(),
			    tourism_with_id[Price] = 0, 1,
			    tourism_with_id[Price] <= 20000, 2,
			    tourism_with_id[Price] <= 50000, 3,
			    tourism_with_id[Price] <= 150000, 4,
			    5
			)
		formatString: 0
		lineageTag: 5065e169-b652-470a-a977-775be45c38b8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Place_Name_English
		dataType: string
		lineageTag: f6aa4fdc-90d2-4476-93b2-6f41d21e9871
		summarizeBy: none
		sourceColumn: Place_Name_English

		annotation SummarizationSetBy = Automatic

	column 'Display Rank' =
			
			VAR ThisCity = tourism_with_id[City]
			VAR ThisRating = tourism_with_id[Rating]
			RETURN
			    RANKX(
			        FILTER(tourism_with_id, tourism_with_id[City] = ThisCity),
			        tourism_with_id[Rating],
			        ThisRating,
			        DESC,
			        DENSE
			    )
		formatString: 0
		lineageTag: 32906650-0bc8-475e-b9f9-523eecfc6d7f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

