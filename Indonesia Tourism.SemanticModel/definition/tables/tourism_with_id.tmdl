	column Long
		dataType: double
		lineageTag: fbf2d57e-6095-4f8d-894c-6566ed9e1e61
		dataCategory: Longitude
		summarizeBy: none
		sourceColumn: Long

		annotation SummarizationSetBy = Automatic

