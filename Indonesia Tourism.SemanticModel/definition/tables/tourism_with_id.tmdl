table tourism_with_id
	lineageTag: e151bfc8-7151-4651-8679-8ce129f5b21a

	measure 'Total Attractions' = DISTINCTCOUNT(tourism_with_id[Place_Id])
		formatString: 0
		lineageTag: 7e06d2d5-a853-4d00-a36b-84c8a00dcf03

	measure 'Average Prize' = "Rp " & FORMAT(AVERAGE(tourism_with_id[Price]), "#,##0")
		lineageTag: 1a7bd59f-061a-4443-82e9-232c712580b7

	measure 'Average Rating' = AVERAGE(tourism_with_id[Rating])
		lineageTag: e1fc67e6-d68d-4e1c-a671-43c1c7507f5f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Cities' = DISTINCTCOUNT(tourism_with_id[City])
		formatString: 0
		lineageTag: 9ede3e36-cd53-4133-858a-47178bca4cc0

	measure 'Selected City' = SELECTEDVALUE(tourism_with_id[City], "Select a City")
		lineageTag: 4b660e09-46ef-46c5-aafa-819848449a86

	measure 'Rating Rank' =
			
			VAR RankTable =
			    ADDCOLUMNS(
			        ALLSELECTED(tourism_with_id[Place_Id]),
			        "@Score",
			        CALCULATE(MAX(tourism_with_id[Rating])) * 1000000 - CALCULATE(MAX(tourism_with_id[Price]))
			    )
			VAR CurrentScore =
			    MAX(tourism_with_id[Rating]) * 1000000 - MAX(tourism_with_id[Price])
			RETURN
			    RANKX(RankTable, [@Score], CurrentScore, DESC, DENSE)
		formatString: 0
		lineageTag: 72aa4023-b819-4de6-8410-2d1b15b7ab04

	column Place_Id
		dataType: int64
		formatString: 0
		lineageTag: a118db88-78c6-4cf8-ba39-8196cf650c77
		summarizeBy: none
		sourceColumn: Place_Id

		annotation SummarizationSetBy = Automatic

